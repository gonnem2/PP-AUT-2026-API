APP_DB_PORT=5435
APP_DB_HOST=localhost
APP_DB_USER=postgres
APP_DB_PASSWORD=postgres
APP_DB_NAME=postgres
REDIS_DSN=redis://localhost:6379
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=3600
SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
ALGORITHM=HS256
# JSON array of allowed browser origins when accessing the API directly.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional server-side token for higher GitHub API rate limits.
# GITHUB_TOKEN=

# RabbitMQ: локальные значения для разработки, на сервере замените пароль.
RABBITMQ_USER=resumehub
RABBITMQ_PASSWORD=resumehub
RABBITMQ_URL=amqp://resumehub:resumehub@localhost:5672/
ML_EXCHANGE=resumehub.ml
ML_REQUEST_KEY=github.report.requested
ML_COMPLETED_KEY=github.report.completed
ML_FAILED_KEY=github.report.failed
RABBITMQ_PREFETCH_COUNT=1
ML_REQUEST_QUEUE=resumehub.ml.requests
ML_RESULT_QUEUE=resumehub.ml.results
ML_DEAD_LETTER_QUEUE=resumehub.ml.invalid-results
REPORT_PREPARE_TIMEOUT=120
REPORT_LEASE_SECONDS=180
REPORT_MAX_ATTEMPTS=5
REPORT_RESULT_TIMEOUT=1800
REPORT_MESSAGE_BYTES=4000000
